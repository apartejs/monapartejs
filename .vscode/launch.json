{
  // Le scaffold Angular CLI proposait une conf « ng test » sur localhost:9876
  // (Karma). Le projet est sous Vitest : les tests se lancent avec `pnpm test`
  // ou `pnpm test:watch`, pas dans un navigateur.
  "version": "0.2.0",
  "configurations": [
    {
      "name": "ng serve",
      "type": "chrome",
      "request": "launch",
      "preLaunchTask": "npm: start",
      "url": "http://localhost:4200/"
    }
  ]
}
