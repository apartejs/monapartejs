{
  "name": "monapartejs",
  "version": "0.1.0",
  "description": "aparté — assistant personnel 100 % local, dans le navigateur",
  "scripts": {
    "ng": "ng",
    "start": "ng serve",
    "build": "ng build",
    "watch": "ng build --watch --configuration development",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc -p tsconfig.app.json --noEmit",
    "typecheck:worker": "tsc --noEmit --strict --target ES2022 --module ES2022 --moduleResolution bundler --skipLibCheck --lib ES2022,DOM,WebWorker src/app/souffleurs/souffleurs.worker.ts",
    "verify": "pnpm typecheck && pnpm typecheck:worker && pnpm test"
  },
  "private": true,
  "dependencies": {
    "@angular/common": "^19.2.0",
    "@angular/compiler": "^19.2.0",
    "@angular/core": "^19.2.0",
    "@angular/forms": "^19.2.0",
    "@angular/platform-browser": "^19.2.0",
    "@angular/platform-browser-dynamic": "^19.2.0",
    "@angular/router": "^19.2.0",
    "@angular/service-worker": "^19.2.25",
    "@aparte/angular": "0.7.0",
    "@aparte/core": "0.7.0",
    "@aparte/engine": "0.7.0",
    "@aparte/locale-fr": "0.7.0",
    "@aparte/plugin-ask-question": "0.7.0",
    "@aparte/plugin-marked": "0.7.0",
    "@aparte/plugin-model-selector": "0.7.0",
    "@aparte/plugin-shiki": "0.7.0",
    "@aparte/plugin-streaming-markdown": "0.7.0",
    "@faker-js/faker": "^10.5.0",
    "@huggingface/transformers": "^4.2.0",
    "chart.js": "^4.5.1",
    "date-fns": "^4.4.0",
    "dexie": "^4.0.10",
    "docx": "^9.7.1",
    "exceljs": "^4.4.0",
    "jspdf": "^4.2.1",
    "jspdf-autotable": "^5.0.8",
    "katex": "^0.18.1",
    "lodash-es": "^4.18.1",
    "marked": "^18.0.0",
    "mathjs": "^15.2.0",
    "mermaid": "^11.16.0",
    "onnxruntime-web": "1.26.0-dev.20260416-b7804b056c",
    "pdf-lib": "^1.17.1",
    "pdfjs-dist": "^6.1.200",
    "rxjs": "~7.8.0",
    "shiki": "^4.0.0",
    "simple-statistics": "^7.9.3",
    "streaming-markdown": "^0.2.15",
    "tslib": "^2.3.0",
    "zone.js": "~0.15.0"
  },
  "devDependencies": {
    "@angular-devkit/build-angular": "^19.2.27",
    "@angular/cli": "^19.2.27",
    "@angular/compiler-cli": "^19.2.0",
    "@types/lodash-es": "^4.17.12",
    "fake-indexeddb": "^6.0.0",
    "typescript": "~5.7.2",
    "vitest": "^3.0.0"
  },
  "packageManager": "pnpm@10.32.1",
  "engines": {
    "node": ">=22"
  }
}
